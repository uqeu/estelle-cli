{
  "description": "Estelle — repository memory and scoped checks, with explicit enforcement policy. GENERATED from `HOOK_TABLE` in tui/src/top_level.rs; do not edit this file — change that table and re-run its test with ESTELLE_REGENERATE_PLUGIN_HOOKS=1. These hooks execute commands on the customer's machine: the runner is resolved through the `latest` dist-tag rather than the major-version range ADR 0015 chose, because a range is a satisfaction test against the customer's disk and no publish could move them off a stale copy (measured, see PLUGIN_HOOK_RUNNER); every settings write is backup-before-write and refuses an unparseable file. Required candidate admission and synchronous answer review require native runner 0.4.1 or newer; a plugin-only update does not prove that the runner was upgraded. Review modified hook trust in the host and restart the session.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook ground",
            "timeout": 30,
            "statusMessage": "Estelle hook ground"
          }
        ]
      },
      {
        "matcher": "Bash|shell_command|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook guard",
            "timeout": 10,
            "statusMessage": "Estelle hook guard"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook pull",
            "timeout": 5,
            "statusMessage": "Estelle hook pull"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook sync",
            "timeout": 30,
            "async": true,
            "statusMessage": "Estelle hook sync"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook distil",
            "timeout": 10,
            "statusMessage": "Estelle hook distil"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook review",
            "timeout": 30,
            "statusMessage": "Estelle hook review"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook checkpoint",
            "timeout": 30,
            "async": true,
            "statusMessage": "Estelle hook checkpoint"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook checkpoint",
            "timeout": 30,
            "async": true,
            "statusMessage": "Estelle hook checkpoint"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook checkpoint",
            "timeout": 30,
            "statusMessage": "Estelle hook checkpoint"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook checkpoint",
            "timeout": 3,
            "statusMessage": "Estelle hook checkpoint"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook welcome",
            "timeout": 30,
            "statusMessage": "Estelle hook welcome"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook context",
            "timeout": 30,
            "statusMessage": "Estelle hook context"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook context",
            "timeout": 30,
            "statusMessage": "Estelle hook context"
          }
        ]
      }
    ]
  }
}
