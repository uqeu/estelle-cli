{
  "description": "Estelle — memory + the grounding gate, always on. GENERATED from `HOOK_TABLE` in tui/src/top_level.rs; do not edit this file — change that table and re-run its test with ESTELLE_REGENERATE_PLUGIN_HOOKS=1. These hooks execute commands on the customer's machine: the runner is resolved through the `latest` dist-tag rather than the major-version range ADR 0015 chose, because a range is a satisfaction test against the customer's disk and no publish could move them off a stale copy (measured, see PLUGIN_HOOK_RUNNER); every settings write is backup-before-write and refuses an unparseable file.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook ground",
            "timeout": 30,
            "statusMessage": "Estelle hook ground"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook guard",
            "timeout": 10,
            "statusMessage": "Estelle hook guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook sync",
            "timeout": 30,
            "async": true,
            "statusMessage": "Estelle hook sync"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook distil",
            "timeout": 10,
            "statusMessage": "Estelle hook distil"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook checkpoint",
            "timeout": 30,
            "async": true,
            "statusMessage": "Estelle hook checkpoint"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook checkpoint",
            "timeout": 30,
            "async": true,
            "statusMessage": "Estelle hook checkpoint"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook checkpoint",
            "timeout": 30,
            "statusMessage": "Estelle hook checkpoint"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook checkpoint",
            "timeout": 3,
            "statusMessage": "Estelle hook checkpoint"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook welcome",
            "timeout": 30,
            "statusMessage": "Estelle hook welcome"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook context",
            "timeout": 30,
            "statusMessage": "Estelle hook context"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --package=@fatelabs/estelle@latest -- estelle hook context",
            "timeout": 30,
            "statusMessage": "Estelle hook context"
          }
        ]
      }
    ]
  }
}
